{
  "name": "@mangai/desktop",
  "version": "0.1.0",
  "description": "MANGAI local manga creator workspace",
  "author": "MANGAI",
  "private": true,
  "type": "module",
  "main": "dist-main/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist-main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:main && vite build",
    "build:packages": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/project-core/tsconfig.json && tsc -p ../../packages/export-core/tsconfig.json && tsc -p ../../packages/ai-core/tsconfig.json && tsc -p ../../packages/canvas-core/tsconfig.json",
    "build:main": "npm run build:packages && tsc -p tsconfig.main.json && node scripts/copy-preload-manifest.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/database.test.mjs tests/ai.test.mjs tests/hub-status.test.mjs tests/diagnostics.test.mjs tests/updater.test.mjs",
    "test:export-acceptance": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron --test --test-name-pattern=\"RC multi-page export\" tests/database.test.mjs",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:signed": "node scripts/build-signed.mjs",
    "dist:win:update": "node scripts/build-update-release.mjs",
    "verify:win:artifacts": "node scripts/check-windows-artifacts.mjs",
    "test:win:installer": "node scripts/smoke-windows-installer.mjs",
    "test:win:cross-volume-trash": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-cross-volume-trash.mjs",
    "generate:win:evidence": "node scripts/generate-windows-release-evidence.mjs"
  },
  "dependencies": {
    "@mangai/ai-core": "file:../../packages/ai-core",
    "@mangai/canvas-core": "file:../../packages/canvas-core",
    "@mangai/export-core": "file:../../packages/export-core",
    "@mangai/project-core": "file:../../packages/project-core",
    "@mangai/shared": "file:../../packages/shared",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "jp.mangai.creator.desktop",
    "productName": "MANGAI Desktop",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "build/diagnostics-upload-config.json",
        "to": "diagnostics-upload-config.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MANGAI-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MANGAI Desktop"
    }
  }
}
