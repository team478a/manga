{
  "name": "@mangai/desktop",
  "version": "0.1.0",
  "description": "MANGAI local manga creator workspace",
  "author": "MANGAI",
  "private": true,
  "type": "module",
  "main": "dist-main/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist-main/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run build:main && vite build",
    "build:packages": "tsc -p ../../packages/shared/tsconfig.json && tsc -p ../../packages/project-core/tsconfig.json && tsc -p ../../packages/export-core/tsconfig.json && tsc -p ../../packages/ai-core/tsconfig.json && tsc -p ../../packages/canvas-core/tsconfig.json",
    "build:main": "npm run build:packages && tsc -p tsconfig.main.json && node scripts/copy-preload-manifest.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint src",
    "test": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron --test tests/database.test.mjs tests/ai.test.mjs tests/dezgo.test.mjs tests/adult-provider-policy.test.mjs tests/hub-status.test.mjs tests/diagnostics.test.mjs tests/updater.test.mjs tests/phase5-hardware-acceptance.test.mjs tests/adult-pilot-bundle.test.mjs tests/adult-pilot-local-bundle.test.mjs tests/adult-pilot-downloader.test.mjs tests/adult-pilot-runtime-installer.test.mjs tests/adult-pilot-runtime-config.test.mjs tests/adult-pilot-runtime-supervisor.test.mjs tests/adult-pilot-runtime-acceptance.test.mjs tests/adult-pilot-workflow-registration.test.mjs tests/adult-pilot-stop-recovery-runbook.test.mjs tests/adult-pilot-invite-ledger.test.mjs tests/adult-pilot-release-readiness.test.mjs tests/adult-pilot-owner-approval.test.mjs tests/adult-pilot-7zip.test.mjs tests/design-tokens.test.mjs tests/design-components.test.mjs tests/design-command-palette.test.mjs tests/design-home-screen.test.mjs tests/design-command-palette-integration.test.mjs tests/design-home-project-grid.test.mjs",
    "adult:pilot-owner-approval:record": "node scripts/record-adult-pilot-owner-approval.mjs",
    "adult:pilot-release-readiness": "node scripts/check-adult-pilot-release-readiness.mjs",
    "adult:pilot-release-readiness:strict": "node scripts/check-adult-pilot-release-readiness.mjs --strict",
    "adult:pilot-local-bundle:verify": "node scripts/verify-adult-pilot-local-bundle.mjs --strict",
    "adult:pilot-ledger:check": "node scripts/check-adult-pilot-invite-ledger.mjs",
    "test:phase5-offline": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron --test --test-name-pattern=\"Phase 5 offline adult\" tests/ai.test.mjs",
    "test:a11y": "npm run build && node scripts/test-accessibility.mjs",
    "test:display-acceptance": "npm run build && cross-env MANGAI_A11Y_VARIANT=scale-150 node scripts/test-accessibility.mjs && cross-env MANGAI_A11Y_VARIANT=high-contrast node scripts/test-accessibility.mjs",
    "test:export-acceptance": "npm run build:main && cross-env ELECTRON_RUN_AS_NODE=1 electron --test --test-name-pattern=\"RC multi-page export\" tests/database.test.mjs",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win:signed": "node scripts/build-signed.mjs",
    "dist:win:update": "node scripts/build-update-release.mjs",
    "verify:win:artifacts": "node scripts/check-windows-artifacts.mjs",
    "test:win:installer": "node scripts/smoke-windows-installer.mjs",
    "test:win:cross-volume-trash": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/test-cross-volume-trash.mjs",
    "generate:win:evidence": "node scripts/generate-windows-release-evidence.mjs"
  },
  "dependencies": {
    "@mangai/ai-core": "file:../../packages/ai-core",
    "@mangai/canvas-core": "file:../../packages/canvas-core",
    "@mangai/export-core": "file:../../packages/export-core",
    "@mangai/project-core": "file:../../packages/project-core",
    "@mangai/shared": "file:../../packages/shared",
    "@napi-rs/keyring": "^1.3.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "image-size": "^2.0.2",
    "jszip": "^3.10.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.24.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.3",
    "react-konva": "^19.2.5",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.12.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "jp.mangai.creator.desktop",
    "productName": "MANGAI Desktop",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/@napi-rs/keyring*/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "resources/adult-pilot-workflows",
        "to": "adult-pilot-workflows"
      },
      {
        "from": "build/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "build/diagnostics-upload-config.json",
        "to": "diagnostics-upload-config.json"
      },
      {
        "from": "build/adult-provider-policy-trust.json",
        "to": "adult-provider-policy-trust.json"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MANGAI-Desktop-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MANGAI Desktop"
    }
  }
}
