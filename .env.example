NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MANGAI_CLOUD_AI_WORKER_SECRET=replace-with-at-least-32-random-characters
MANGAI_CLOUD_AI_WORKER_ENABLED=false
MANGAI_CLOUD_AI_WORKER_ID=mangai-cloud-worker-1
MANGAI_CLOUD_AI_WORKER_LEASE_SECONDS=300
MANGAI_CLOUD_IMAGE_ENABLED=false
MANGAI_CLOUD_IMAGE_MODEL=general-image-v1
MANGAI_CLOUD_IMAGE_PRICING_VERSION=replace-after-provider-contract
MANGAI_CLOUD_TEXT_ENABLED=false
MANGAI_CLOUD_TEXT_MODEL=general-text-v1
MANGAI_CLOUD_TEXT_PRICING_VERSION=replace-after-provider-contract
MANGAI_CLOUD_AI_GATEWAY_ENDPOINT=https://ai-gateway.example.com/v1/generate
MANGAI_CLOUD_AI_GATEWAY_KEY=replace-with-server-only-gateway-key
# 任意。未設定時はService Role KeyをHMAC秘密値として使用します
CLOUD_AI_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
# 開発・自動テスト専用。本番buildでは無視されます
MANGAI_CLOUD_AI_MOCK_ENABLED=false
# 任意。未設定時はService Role KeyをHMAC秘密値として使用します
DESKTOP_AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CLOUD_AI_CREATOR_PRICE_ID=price_xxx
# 0でtrialなし、1〜90でStripe trial日数
STRIPE_CLOUD_AI_TRIAL_DAYS=14
# 任意。未設定時はSTRIPE_WEBHOOK_SECRETを使用します（16文字以上）
CHECKOUT_CANCEL_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 市場分析MVP。migration適用後にtrueへ変更（未設定・falseは停止）
CLOUD_RESEARCH_MVP_ENABLED=false
CLOUD_PROPOSAL_GENERATION_ENABLED=false
CLOUD_SCENARIO_GENERATION_ENABLED=false
CLOUD_STORYBOARD_GENERATION_ENABLED=false
CLOUD_STORYBOARD_CANVAS_ENABLED=false
CLOUD_PANEL_IMAGE_GENERATION_ENABLED=false
# 許可制の成人向け市場分析。migration適用・管理者許可・本人同意後にtrue
CLOUD_ADULT_RESEARCH_ENABLED=false
CLOUD_ADULT_PLANNING_ENABLED=false
# 許可制の成人向けAI企画。一般向け企画Flag・migration・DB Kill Switch・個別許可・本人同意も必要
CLOUD_ADULT_AI_PLANNING_ENABLED=false
# 任意。trueの場合だけ許可hostのHTTPS出典をServerから取得検証
CLOUD_RESEARCH_SOURCE_VERIFICATION_ENABLED=false
CLOUD_RESEARCH_SOURCE_ALLOWED_HOSTS=www.example.jp
# 任意。false・未設定でも手動出典入力で市場分析を継続可能
CLOUD_RESEARCH_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=replace-with-server-only-search-key
# 検索・事実候補抽出を有効化する場合に使用（32byte以上、Server専用）
CLOUD_RESEARCH_SEARCH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes
# 旧Web版ローカル販売ツールを開発時だけ有効にする場合
MANGAI_ENABLE_LEGACY_LOCAL_TOOLS=false
CLOUD_ADULT_SCENARIO_GENERATION_ENABLED=false
CLOUD_ADULT_STORYBOARD_GENERATION_ENABLED=false
CLOUD_ADULT_CANVAS_ENABLED=false
CLOUD_ADULT_WORK_MANAGEMENT_ENABLED=false
# 1〜3名の限定モニターだけに成人向け制作フローを提供する第2段階
CLOUD_ADULT_MONITOR_BETA_ENABLED=false

# Hub DB staging preflight用。アプリ起動時は不要です
MANGAI_DB_ENV=staging
PGHOST=db.your-project.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your-staging-database-password
PGSSLMODE=require
