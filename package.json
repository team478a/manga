{
  "name": "mangai-creator-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:packages && next build",
    "build:packages": "npm run build --prefix packages/shared && npm run build --prefix packages/project-core && npm run build --prefix packages/export-core && npm run build --prefix packages/ai-core && npm run build --prefix packages/canvas-core",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:hub && npm --prefix apps/desktop run typecheck",
    "typecheck:hub": "tsc --noEmit",
    "deps:check": "node scripts/check-dependency-boundaries.mjs && node scripts/check-module-boundaries.mjs && node scripts/check-codebase-size-regressions.mjs",
    "modules:check": "node scripts/check-module-boundaries.mjs",
    "codebase:size:check": "node scripts/check-codebase-size-regressions.mjs",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:test": "npm --prefix apps/desktop run test",
    "phase5:offline-acceptance": "npm --prefix apps/desktop run test:phase5-offline",
    "phase5:hardware-acceptance": "node apps/desktop/scripts/check-phase5-hardware-acceptance.mjs",
    "phase5:hardware-evidence:import": "node apps/desktop/scripts/check-phase5-hardware-acceptance.mjs --import",
    "phase5:hardware-acceptance:strict": "node apps/desktop/scripts/check-phase5-hardware-acceptance.mjs --strict",
    "desktop:test:a11y": "npm --prefix apps/desktop run test:a11y",
    "desktop:test:display-acceptance": "npm --prefix apps/desktop run test:display-acceptance",
    "desktop:pack:win": "npm --prefix apps/desktop run pack:win",
    "desktop:dist:win": "npm --prefix apps/desktop run dist:win",
    "desktop:dist:win:signed": "npm --prefix apps/desktop run dist:win:signed",
    "desktop:dist:win:update": "npm --prefix apps/desktop run dist:win:update",
    "canvas:test": "npm --prefix packages/canvas-core test",
    "ai:test": "npm --prefix packages/ai-core test",
    "hub:test": "node --experimental-strip-types --test tests/*.test.mjs",
    "research:eval": "node --experimental-strip-types scripts/evaluate-cloud-research.mjs",
    "cloud:release1:preflight": "node scripts/check-cloud-release1-preflight.mjs",
    "cloud:release2:preflight": "node scripts/check-cloud-release2-preflight.mjs",
    "cloud:release3:preflight": "node scripts/check-cloud-release3-preflight.mjs",
    "cloud:release4:preflight": "node scripts/check-cloud-release4-preflight.mjs",
    "cloud:release5:preflight": "node scripts/check-cloud-release5-preflight.mjs",
    "cloud:release6:preflight": "node scripts/check-cloud-release6-preflight.mjs",
    "cloud:general-monitor:preflight": "node scripts/check-cloud-general-monitor-beta-preflight.mjs",
    "cloud:manga:acceptance:preflight": "node scripts/check-cloud-manga-acceptance.mjs",
    "cloud:manga:acceptance:repo": "node scripts/check-cloud-manga-acceptance.mjs --repository-only",
    "cloud:manga:owner-isolation": "node scripts/check-cloud-owner-isolation.mjs",
    "cloud:manga:owner-isolation:staging": "node scripts/check-cloud-owner-isolation-staging.mjs",
    "cloud:manga:owner-isolation:staging:preflight": "node scripts/check-cloud-owner-isolation-staging.mjs --preflight",
    "manga:quality:benchmark:preflight": "node --experimental-strip-types scripts/check-manga-quality-benchmark.mjs",
    "manga:quality:benchmark:strict": "node --experimental-strip-types scripts/check-manga-quality-benchmark.mjs --strict",
    "manga:quality:benchmark:assembly:audit": "node --experimental-strip-types scripts/assemble-manga-quality-benchmark.mjs",
    "manga:quality:benchmark:assembly:strict": "node --experimental-strip-types scripts/assemble-manga-quality-benchmark.mjs --strict",
    "manga:quality:benchmark:assembly:write": "node --experimental-strip-types scripts/assemble-manga-quality-benchmark.mjs --write",
    "manga:quality:benchmark:leak": "node scripts/run-manga-quality-benchmark-leak.mjs",
    "manga:benchmark:review-package:build": "node --experimental-strip-types scripts/build-manga-quality-review-package.mjs",
    "manga:benchmark:review-package:validate": "node --experimental-strip-types scripts/validate-manga-quality-review-package.mjs",
    "manga:benchmark:rights-package:validate": "node scripts/validate-manga-quality-rights-review-package.mjs",
    "manga:benchmark:monitor-batch:admit": "node scripts/import-manga-quality-monitor-review-batch.mjs",
    "manga:benchmark:review-transfer:passphrase": "node scripts/generate-manga-quality-review-transfer-passphrase.mjs",
    "manga:benchmark:review-transfer:build": "node scripts/build-manga-quality-secure-review-transfer.mjs",
    "manga:benchmark:review-transfer:validate": "node scripts/validate-manga-quality-secure-review-transfer.mjs",
    "manga:benchmark:review-response:validate": "node --experimental-strip-types scripts/validate-manga-quality-review-response.mjs",
    "manga:benchmark:review-responses:compare": "node --experimental-strip-types scripts/compare-manga-quality-review-responses.mjs",
    "cloud:production:routes": "node scripts/check-cloud-production-routes.mjs",
    "cloud:production:routes:preflight": "node scripts/check-cloud-production-routes.mjs --preflight",
    "cloud:ai-worker:scheduler": "node scripts/run-cloud-ai-worker-scheduler.mjs",
    "cloud:ai-worker:scheduler:preflight": "node scripts/run-cloud-ai-worker-scheduler.mjs --check",
    "cloud:export:preflight": "node scripts/check-cloud-export-preflight.mjs",
    "cloud:storage:preflight": "node scripts/check-cloud-storage-preflight.mjs",
    "cloud:longform:acceptance": "node --experimental-strip-types --test tests/cloud-100-page-acceptance.test.mjs",
    "db:migrations:validate": "node scripts/validate-supabase-migrations.mjs",
    "db:migrations:checksums:update": "node scripts/update-supabase-migration-checksums.mjs --write",
    "db:staging:preflight": "node scripts/check-supabase-staging.mjs",
    "rc:preflight": "node scripts/check-release-candidate.mjs",
    "rc:preflight:strict": "node scripts/check-release-candidate.mjs --strict",
    "rc:external:preflight": "node scripts/check-rc-external-environments.mjs",
    "rc:external:probe": "node scripts/check-rc-external-environments.mjs --probe",
    "rc:acceptance": "node scripts/check-rc-acceptance.mjs",
    "rc:acceptance:strict": "node scripts/check-rc-acceptance.mjs --strict",
    "rc:acceptance:test": "node --test tests/rc-acceptance.test.mjs",
    "rc:export-acceptance": "npm --prefix apps/desktop run test:export-acceptance",
    "rc:windows-artifacts": "node apps/desktop/scripts/check-windows-artifacts.mjs",
    "rc:windows-installer-e2e": "node apps/desktop/scripts/smoke-windows-installer.mjs",
    "rc:clean-windows-acceptance": "node apps/desktop/scripts/check-clean-windows-acceptance.mjs",
    "rc:clean-windows-acceptance:strict": "node apps/desktop/scripts/check-clean-windows-acceptance.mjs --strict",
    "rc:windows-cross-volume-trash": "npm --prefix apps/desktop run test:win:cross-volume-trash --",
    "rc:windows-evidence": "node apps/desktop/scripts/generate-windows-release-evidence.mjs",
    "rc:validate": "node scripts/check-release-candidate.mjs --full"
  },
  "dependencies": {
    "@mangai/ai-core": "file:packages/ai-core",
    "@mangai/canvas-core": "file:packages/canvas-core",
    "@mangai/export-core": "file:packages/export-core",
    "@mangai/shared": "file:packages/shared",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "0.35.3",
    "stripe": "^22.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/yazl": "^3.3.1",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "sharp": "0.35.3"
  }
}
